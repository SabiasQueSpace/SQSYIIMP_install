#!/usr/bin/env bash

# ============================================================
# SQSYIIMP legacy "screens" command
# ============================================================

MANAGER="/usr/local/bin/yiimp-screens"

if [[ ! -x "$MANAGER" ]]; then
    echo "ERROR: SQSYIIMP screen manager is not installed"
    exit 1
fi

case "${1:-status}" in

    main|loop2|blocks|debug)
        exec "$MANAGER" attach "$1"
        ;;

    *)
        exec "$MANAGER" "$@"
        ;;

esac
