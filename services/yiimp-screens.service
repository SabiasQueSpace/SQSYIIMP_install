[Unit]
Description=SQSYIIMP YiiMP background screens
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

User=__STORAGE_USER__
Group=__STORAGE_GROUP__

EnvironmentFile=-/etc/default/sqsyiimp

ExecStart=/usr/local/bin/yiimp-screens start
ExecStop=/usr/local/bin/yiimp-screens stop

RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
