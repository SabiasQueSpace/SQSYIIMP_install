source /etc/yiimpool.conf
source /etc/functions.sh

# Define colors
RED=$'\033[00;31m'
GREEN=$'\033[00;32m'
YELLOW=$'\033[00;33m'
CYAN=$'\033[00;36m'
RESET=$'\033[0m'

# Function to check process status
check_process_status() {
    local process_name="$1"
    if ps aux | grep -q "[${process_name:0:1}]${process_name:1}"; then
        echo "${GREEN}running${RESET}"
    else
        echo "${RED}stopped${RESET}"
    fi
}

# Function to display header information
print_header() {
    printf "%-7s %-25s %-16s %-15s\n" "$1" "$2" "$3" "$4"
}

# Function to display a colored message
colored_message() {
    echo "${CYAN}$1${RESET}"
}

# Return a colored health label from a percentage/value and two thresholds.
health_label() {
    local value="$1" warning="$2" critical="$3"
    if [ "$value" -ge "$critical" ]; then
        printf "%sCRITICAL%s" "$RED" "$RESET"
    elif [ "$value" -ge "$warning" ]; then
        printf "%sWARNING%s" "$YELLOW" "$RESET"
    else
        printf "%sOK%s" "$GREEN" "$RESET"
    fi
}

# Print a systemd service status without failing when a package is absent.
service_status() {
    local unit="$1"
    if systemctl is-active --quiet "$unit" 2>/dev/null; then
        printf "%srunning%s" "$GREEN" "$RESET"
    elif systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q .; then
        printf "%sstopped%s" "$RED" "$RESET"
    else
        printf "%snot installed%s" "$YELLOW" "$RESET"
    fi
}

# Find the installed PHP-FPM unit (for example php8.1-fpm.service).
php_fpm_status() {
    local unit
    unit=$(systemctl list-unit-files 'php*-fpm.service' --no-legend 2>/dev/null | awk 'NR==1 {print $1}')
    if [ -n "$unit" ]; then
        service_status "$unit"
    else
        printf "%snot installed%s" "$YELLOW" "$RESET"
    fi
}

firewall_status() {
    if ! command -v ufw >/dev/null 2>&1; then
        printf "%snot installed%s" "$YELLOW" "$RESET"
    elif ufw status 2>/dev/null | grep -q '^Status: active'; then
        printf "%senabled%s" "$GREEN" "$RESET"
    else
        printf "%sdisabled%s" "$RED" "$RESET"
    fi
}

# Display current date and time
date=$(date)
echo -e "${YELLOW}Current date and time:${GREEN} $date ${RESET}"
echo

# Display system information
colored_message "System information:"
echo
/usr/bin/landscape-sysinfo
echo

# Health overview. Thresholds: memory/disk/inodes 80/90%, swap 20/80%,
# temperature 70/85 C; load is compared with the number of CPU cores.
colored_message "Health:"
cpu_load=$(awk '{print $1}' /proc/loadavg)
cpu_cores=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
cpu_load_x100=$(awk -v load="$cpu_load" 'BEGIN {printf "%.0f", load * 100}')
cpu_warning=$((cpu_cores * 100))
cpu_critical=$((cpu_cores * 200))
memory_pct=$(free | awk '/^Mem:/ {printf "%.0f", ($3/$2)*100}')
disk_pct=$(df -P / | awk 'NR==2 {gsub(/%/, "", $5); print $5}')
inode_pct=$(df -Pi / | awk 'NR==2 {gsub(/%/, "", $5); print $5}')
swap_pct=$(free | awk '/^Swap:/ {if ($2 == 0) print 0; else printf "%.0f", ($3/$2)*100}')
temperature=""
for thermal_file in /sys/class/thermal/thermal_zone*/temp; do
    if [ -r "$thermal_file" ]; then
        temperature=$(awk '{printf "%.0f", $1/1000}' "$thermal_file")
        break
    fi
done

printf "  %-14s %-20s %b\n" "CPU load:" "$cpu_load" "$(health_label "$cpu_load_x100" "$cpu_warning" "$cpu_critical")"
printf "  %-14s %-20s %b\n" "Memory:" "${memory_pct}%" "$(health_label "$memory_pct" 80 90)"
printf "  %-14s %-20s %b\n" "Disk /:" "${disk_pct}%" "$(health_label "$disk_pct" 80 90)"
printf "  %-14s %-20s %b\n" "Inodes:" "${inode_pct}%" "$(health_label "$inode_pct" 80 90)"
printf "  %-14s %-20s %b\n" "Swap:" "${swap_pct}%" "$(health_label "$swap_pct" 20 80)"
if [ -n "$temperature" ]; then
    printf "  %-14s %-20s %b\n" "Temperature:" "${temperature} C" "$(health_label "$temperature" 70 85)"
else
    printf "  %-14s %-20s %b\n" "Temperature:" "N/A" "${YELLOW}UNAVAILABLE${RESET}"
fi
echo

colored_message "Core services:"
printf "  %-13s %-22b %-13s %b\n" "Nginx:" "$(service_status nginx.service)" "PHP-FPM:" "$(php_fpm_status)"
printf "  %-13s %-22b %-13s %b\n" "MariaDB:" "$(service_status mariadb.service)" "Fail2ban:" "$(service_status fail2ban.service)"
printf "  %-13s %-22b %-13s %b\n" "Cron:" "$(service_status cron.service)" "Firewall:" "$(firewall_status)"
echo

# Pool status
colored_message "SQSYIIMP Status:"
STORAGE_USER="${STORAGE_USER:-crypto-data}"
STORAGE_ROOT="${STORAGE_ROOT:-/home/${STORAGE_USER}}"
daemon="${STORAGE_ROOT}/wallets"
site="${STORAGE_ROOT}/yiimp/site"
echo
print_header "Main:" "$(check_process_status 'main')" \
    "Wallets:" "${YELLOW}$daemon${RESET}"

print_header "Blocks:" "$(check_process_status 'blocks')" \
    "YiiMP Site:" "${YELLOW}$site${RESET}"

print_header "Loop2:" "$(check_process_status 'loop2')" \
    "Hint:" "${GREEN}yiimp-screens attach main|loop2|blocks|debug${RESET}"

print_header "Debug:" "$(check_process_status 'log/debug.log')" \
    "Hint:" "${GREEN}detach: ctrl+a,d${RESET}"
echo

# Server screens
colored_message "YiiMP screen manager:"
echo -e "${YELLOW}Control screens with:${RESET} ${GREEN}screens start${RESET} ${YELLOW}|${RESET} ${RED}screens stop${RESET} ${YELLOW}|${RESET} ${YELLOW}screens restart${RESET}"
echo
echo -e "${CYAN}Targets:${RESET} ${GREEN}main${RESET} ${YELLOW}|${RESET} ${GREEN}loop2${RESET} ${YELLOW}|${RESET} ${GREEN}blocks${RESET} ${YELLOW}|${RESET} ${GREEN}debug${RESET}"
echo

# Reload hint
colored_message "Refresh this dashboard with: ${GREEN}motd${RESET}"
echo

# Display pending reboots and package updates
/usr/lib/update-notifier/update-motd-reboot-required
/usr/lib/update-notifier/apt-check --human-readable
echo
